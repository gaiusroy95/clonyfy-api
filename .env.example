SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Direct Postgres URI for schema migrations (npm run db:migrate).
# Supabase → Project Settings → Database → Connection string → URI
SUPABASE_DB_URL=

# Required for /admin. Use a long random value and set the same value in your
# hosting provider's environment variables.
ADMIN_PASSWORD=

# Strongly recommended in production.
PASSWORD_PEPPER=
SHARE_PASSWORD_PEPPER=

# Optional.
PORT=5000
# Full-site crawl budget for Scale "Select all pages" (dedicated Node hosts).
# Only when CLONYFY_SERVERLESS=1: CLONYFY_SERVERLESS_FULL_SITE_MAX_PAGES also applies.
CLONYFY_FULL_SITE_MAX_PAGES=10000
CLONYFY_FULL_SITE_DEPTH=256
# CLONYFY_SERVERLESS_MAX_PAGES=500
# CLONYFY_SERVERLESS_FULL_SITE_MAX_PAGES=500

# Backend public URL (OAuth callback, emails that hit the API).
# On Render, RENDER_EXTERNAL_URL is used if APP_URL is unset.
APP_URL=http://localhost:5000
# Frontend app origin (CORS + post-login / OAuth browser redirects).
FRONTEND_URL=http://localhost:8080
# Comma-separated extra browser origins allowed for CORS (www + apex in production).
# CORS_ORIGINS=https://www.clonyfy.com,https://clonyfy.com,https://clonyfy-haq5.vercel.app
PUBLIC_APP_URL=
# Optional: force share links onto a specific host/subdomain.
SHARE_BASE_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Google OAuth (client ID/secret) is NOT an env var -- configure it from the
# /admin panel's Settings section instead; it's stored in the database.

# Figma Community plugin (production)
# After publishing Clonyfy Import, set the listing URL so the Export Figma modal
# shows "Install Clonyfy Import" for customers (no local figma-plugin folder).
# Example: https://www.figma.com/community/plugin/1677522506571131225/Clonyfy-Import
FIGMA_COMMUNITY_PLUGIN_URL=https://www.figma.com/community/plugin/1677522506571131225/Clonyfy-Import
# Until published: customers use Download SVG for Figma Web; Desktop plugin is for
# Development installs / internal testing only. See figma-plugin/PUBLISH.md.
