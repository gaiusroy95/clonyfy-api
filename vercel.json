{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api?__clonyfy_path=/$1"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "memory": 3008,
      "includeFiles": "{packages/cloner/dist/**,node_modules/@sparticuz/chromium/**,node_modules/playwright-core/**}"
    }
  }
}
